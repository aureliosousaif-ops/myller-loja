# ============================================================
# MYLLER — exemplo de variáveis de ambiente
# Copie para .env e preencha com os valores reais:
#     copy .env.example .env
# NUNCA versione o arquivo .env.
# ============================================================

# ------------------------------------------------------------
# Django
# ------------------------------------------------------------
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-de-64-caracteres
DJANGO_DEBUG=True
# Produção: DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Produção: DJANGO_ALLOWED_HOSTS=www.myller.com.br,myller.com.br
# Produção: DJANGO_CSRF_TRUSTED_ORIGINS=https://www.myller.com.br,https://myller.com.br
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------
# Banco de dados
# Desenvolvimento: deixe POSTGRES_DB vazio -> usa SQLite (db.sqlite3)
# Produção: preencha para usar PostgreSQL
# ------------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# ------------------------------------------------------------
# E-mail (recuperação de senha, notificações)
# Desenvolvimento padrão: console (imprime no terminal)
# Produção (pendência real): configure um SMTP — por exemplo:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.seuprovedor.com
#   EMAIL_HOST_USER=sua-conta@seudominio.com
#   EMAIL_HOST_PASSWORD=senha-do-smtp
#   DEFAULT_FROM_EMAIL=loja@seudominio.com
# ------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ------------------------------------------------------------
# Pagamentos (camada abstrata)
# PAYMENT_GATEWAY = none | mercadopago | stripe
#   none        -> nenhuma aprovação automática (padrão)
#   mercadopago -> checkout real do Mercado Pago + webhook
#   stripe      -> checkout real do Stripe + webhook
# Sem credenciais o pedido permanece "Aguardando pagamento".
# ------------------------------------------------------------
PAYMENT_GATEWAY=none

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Frete
# FRETE_BACKEND = tabela | melhorenvio | correios
#   tabela      -> cálculo interno por peso/CEP (rótulo "estimativa")
#   melhorenvio -> API da Melhor Envio (exige MELHOR_ENVIO_TOKEN)
#   correios    -> contrato Correios (exige CORREIOS_CONTRATO/SENHA)
# ------------------------------------------------------------
FRETE_BACKEND=tabela
FRETE_TIMEOUT=8
MELHOR_ENVIO_TOKEN=
CORREIOS_CONTRATO=
CORREIOS_SENHA=

# ------------------------------------------------------------
# Integrações e contato
# ------------------------------------------------------------
SITE_URL=http://localhost:8000
WHATSAPP_NUMERO=
VIA_CEP_URL=https://viacep.com.br/ws
